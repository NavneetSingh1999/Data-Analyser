# Copy this file to ".env" and fill it in when your Shoonya API access is ready.
# Never share or commit the real .env file.
SHOONYA_USER=
SHOONYA_PASSWORD=
# The secret key shown when you set up TOTP (not the 6-digit code itself)
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_KEY=
SHOONYA_IMEI=
